# Credenciais do banco usadas por server/routes/sitemap.xml.ts e google.shopping.xml.ts
# (via runtimeConfig.db em nuxt.config.ts). Copie para .env e preencha ANTES do build:
#   sem .env no momento do build, o sitemap e o feed Shopping saem SEM produtos.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_DATABASE=hardstore
